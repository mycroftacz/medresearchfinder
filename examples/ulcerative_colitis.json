{
  "_comment": "Example config: ulcerative colitis. Copy this file and edit every section for your own condition. 'focus.mesh_terms' must be exact MeSH headings (find them at https://meshb.nlm.nih.gov). 'tracked_terms' maps a display label to the spellings matched (case-insensitive, whole-word) in titles and abstracts -- this list is the main lever over what the report can see, because MeSH has no headings for new drugs or clinical phrases like 'refractory'.",

  "focus": {
    "label": "Ulcerative colitis",
    "mesh_terms": ["Colitis, Ulcerative"],
    "text_terms": ["ulcerative colitis"]
  },

  "start_year": 2018,
  "max_papers": 500,
  "min_focus_papers": 10,
  "topics_per_researcher": 12,
  "min_papers_per_topic": 2,
  "max_stars": 5,

  "extra_boring_mesh": [
